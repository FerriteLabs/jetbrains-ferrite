<templateSet group="FerriteGo">
    <template name="ferrite-conn" value="import &quot;github.com/redis/go-redis/v9&quot;&#10;&#10;rdb := redis.NewClient(&amp;redis.Options{&#10;&#9;Addr: &quot;$HOST$:$PORT$&quot;,&#10;})" description="Ferrite/Redis Go connection" toReformat="true" toShortenFQNames="true">
        <variable name="HOST" expression="" defaultValue="&quot;localhost&quot;" alwaysStopAt="true"/>
        <variable name="PORT" expression="" defaultValue="&quot;6379&quot;" alwaysStopAt="true"/>
        <context>
            <option name="GO" value="true"/>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="ferrite-get" value="val, err := rdb.Get(ctx, &quot;$KEY$&quot;).Result()" description="Ferrite GET in Go" toReformat="true" toShortenFQNames="true">
        <variable name="KEY" expression="" defaultValue="&quot;key&quot;" alwaysStopAt="true"/>
        <context>
            <option name="GO" value="true"/>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="ferrite-set" value="err := rdb.Set(ctx, &quot;$KEY$&quot;, &quot;$VALUE$&quot;, $TTL$).Err()" description="Ferrite SET in Go" toReformat="true" toShortenFQNames="true">
        <variable name="KEY" expression="" defaultValue="&quot;key&quot;" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="TTL" expression="" defaultValue="0" alwaysStopAt="true"/>
        <context>
            <option name="GO" value="true"/>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="ferrite-pipeline" value="pipe := rdb.Pipeline()&#10;get1 := pipe.Get(ctx, &quot;$KEY1$&quot;)&#10;get2 := pipe.Get(ctx, &quot;$KEY2$&quot;)&#10;_, err := pipe.Exec(ctx)" description="Ferrite pipeline in Go" toReformat="true" toShortenFQNames="true">
        <variable name="KEY1" expression="" defaultValue="&quot;key1&quot;" alwaysStopAt="true"/>
        <variable name="KEY2" expression="" defaultValue="&quot;key2&quot;" alwaysStopAt="true"/>
        <context>
            <option name="GO" value="true"/>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="ferrite-setex" value="err := rdb.Set(ctx, &quot;$KEY$&quot;, &quot;$VALUE$&quot;, $SECONDS$*time.Second).Err()" description="Ferrite SETEX in Go" toReformat="true" toShortenFQNames="true">
        <variable name="KEY" expression="" defaultValue="&quot;key&quot;" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="SECONDS" expression="" defaultValue="3600" alwaysStopAt="true"/>
        <context>
            <option name="GO" value="true"/>
            <option name="OTHER" value="true"/>
        </context>
    </template>
</templateSet>
